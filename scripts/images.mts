/**
 * Photo pipeline. Run: npm run images
 *
 * 1. Scans public/images/<category>/ for .jpg/.jpeg/.png/.webp/.avif files.
 * 2. Auto-rotates (EXIF), strips metadata including GPS (privacy), and caps the
 *    longest side at 3200px. The original is overwritten in place as a
 *    high-quality JPEG/PNG.
 * 3. Writes data/photo-files.generated.ts: width, height and a tiny blurred
 *    placeholder (base64 WebP) for each file.
 * 4. Lists files that are not yet linked to a slot in data/photos.ts, so you
 *    can set `file: "/images/<category>/<name>"` on the right slot.
 *
 * AVIF/WebP responsive sizes are generated on demand by next/image
 * (images.formats in next.config.ts), so they are not written to disk.
 */
import { readdirSync, readFileSync, statSync, writeFileSync } from "node:fs";
import { extname, join } from "node:path";
import sharp from "sharp";

const ROOT = "public/images";
const MAX = 3200;
const exts = new Set([".jpg", ".jpeg", ".png", ".webp", ".avif"]);

type Entry = { width: number; height: number; blurDataURL: string };
const out: Record<string, Entry> = {};

for (const category of readdirSync(ROOT)) {
  const dir = join(ROOT, category);
  if (!statSync(dir).isDirectory()) continue;
  for (const name of readdirSync(dir)) {
    if (!exts.has(extname(name).toLowerCase())) continue;
    const file = join(dir, name);
    const input = readFileSync(file);
    const isPng = extname(name).toLowerCase() === ".png";

    // rotate() applies EXIF orientation; sharp drops EXIF/GPS unless withMetadata() is called.
    const pipeline = sharp(input).rotate().resize({ width: MAX, height: MAX, fit: "inside", withoutEnlargement: true });
    const cleaned = isPng ? await pipeline.png({ compressionLevel: 9 }).toBuffer() : await pipeline.jpeg({ quality: 88, mozjpeg: true }).toBuffer();
    if (/\.(jpe?g|png)$/i.test(name)) writeFileSync(file, cleaned);

    const meta = await sharp(cleaned).metadata();
    const blur = await sharp(cleaned).resize(16).webp({ quality: 40 }).toBuffer();
    out[`/images/${category}/${name}`] = {
      width: meta.width ?? 0,
      height: meta.height ?? 0,
      blurDataURL: `data:image/webp;base64,${blur.toString("base64")}`,
    };
  }
}

writeFileSync(
  "data/photo-files.generated.ts",
  `// GENERATED by scripts/images.mts (npm run images) — do not edit.\n` +
    `export const photoFiles: Record<string, { width: number; height: number; blurDataURL: string }> = ${JSON.stringify(out, null, 2)};\n`,
);

const manifest = readFileSync("data/photos.ts", "utf8");
const unlinked = Object.keys(out).filter((p) => !manifest.includes(`"${p}"`));
console.log(`Processed ${Object.keys(out).length} photo(s) → data/photo-files.generated.ts`);
if (unlinked.length) {
  console.log(`Not yet linked to a slot in data/photos.ts (set file: "<path>" and a credit/licence):`);
  for (const p of unlinked) console.log(`  ${p}`);
}
