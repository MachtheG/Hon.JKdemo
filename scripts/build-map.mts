/**
 * Builds data/geo/bomet-paths.ts (SVG path strings) from the openly licensed
 * boundary extracts in data/geo/*.geojson. Run: npm run map
 *
 * Projection: equirectangular, scaled by cos(latitude) — accurate enough for a
 * county ~60 km across sitting on the equator.
 */
import { readFileSync, writeFileSync } from "node:fs";

type Ring = [number, number][];
type Geom = { type: "Polygon"; coordinates: Ring[] } | { type: "MultiPolygon"; coordinates: Ring[][] };
type Feature = { properties: { shapeName: string; constituency?: string }; geometry: Geom };

const read = (f: string) => (JSON.parse(readFileSync(f, "utf8")) as { features: Feature[] }).features;
const cons = read("data/geo/bomet-constituencies.geojson");
const wards = read("data/geo/bomet-wards.geojson");

const polys = (g: Geom): Ring[][] => (g.type === "Polygon" ? [g.coordinates] : g.coordinates);
const allPts = cons.flatMap((f) => polys(f.geometry).flatMap((p) => p.flat()));
const lons = allPts.map((p) => p[0]);
const lats = allPts.map((p) => p[1]);
const [minLon, maxLon, minLat, maxLat] = [Math.min(...lons), Math.max(...lons), Math.min(...lats), Math.max(...lats)];
const kx = Math.cos((((minLat + maxLat) / 2) * Math.PI) / 180);
const W = 1000;
const scale = W / ((maxLon - minLon) * kx);
const H = Math.round((maxLat - minLat) * scale);

const xy = ([lon, lat]: [number, number]) => [((lon - minLon) * kx * scale).toFixed(1), ((maxLat - lat) * scale).toFixed(1)];
const pathOf = (g: Geom) =>
  polys(g)
    .map((poly) => poly.map((ring) => "M" + ring.map((p) => xy(p).join(",")).join("L") + "Z").join(""))
    .join("");

/** Area-weighted centroid of the largest ring, for label placement. */
function labelPoint(g: Geom): [number, number] {
  const ring = polys(g)
    .map((p) => p[0])
    .sort((a, b) => b.length - a.length)[0];
  let a = 0, cx = 0, cy = 0;
  for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
    const [x0, y0] = ring[j], [x1, y1] = ring[i];
    const f = x0 * y1 - x1 * y0;
    a += f; cx += (x0 + x1) * f; cy += (y0 + y1) * f;
  }
  const [x, y] = xy([cx / (3 * a), cy / (3 * a)]);
  return [Number(x), Number(y)];
}

const slug = (s: string) => s.toLowerCase().replace(/'/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
/** Map geoBoundaries spellings to the County Government's ward names. */
const wardName = (s: string) => ({ "Kong'Asis": "Kongasis" })[s] ?? s;

const out = {
  viewBox: `0 0 ${W} ${H}`,
  constituencies: cons
    .map((f) => ({ slug: slug(f.properties.shapeName), name: f.properties.shapeName, d: pathOf(f.geometry), label: labelPoint(f.geometry) }))
    .sort((a, b) => a.name.localeCompare(b.name)),
  wards: wards
    .map((f) => ({
      slug: slug(wardName(f.properties.shapeName)),
      name: wardName(f.properties.shapeName),
      constituency: slug(f.properties.constituency ?? ""),
      d: pathOf(f.geometry),
      label: labelPoint(f.geometry),
    }))
    .sort((a, b) => a.name.localeCompare(b.name)),
};

writeFileSync(
  "data/geo/bomet-paths.ts",
  `// GENERATED by scripts/build-map.mts — do not edit. Boundaries: see data/credits.ts.\n` +
    `export const bometMap = ${JSON.stringify(out)} as const;\n`,
);
console.log(`bomet-paths.ts: ${out.constituencies.length} constituencies, ${out.wards.length} wards, viewBox ${out.viewBox}`);
