# Copy to .env.local (never commit real values — .env* is gitignored).

# Public site URL (share links, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://hon-jkdemo.vercel.app

# Form adapter: console (dev only) | resend | supabase
# In production, forms are switched off until one of resend/supabase is set.
FORM_ADAPTER=console

# Resend (email each submission to the campaign)
RESEND_API_KEY=
FORM_NOTIFY_EMAIL=
FORM_FROM_EMAIL=

# Supabase (insert into tables form_pledge, form_volunteer, form_contact)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Internal review build: show [[TO CONFIRM]] markers (never set this on the public site)
NEXT_PUBLIC_SHOW_TO_CONFIRM=false
